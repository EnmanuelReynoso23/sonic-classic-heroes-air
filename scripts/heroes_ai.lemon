// ==============================================================================
// 🤖 Sonic Classic Heroes AIR - IA de Seguimiento y Formación de Compañeros
// ==============================================================================
// Controla que los 2 personajes acompañantes sigan al líder activo en formación,
// salten con él, y no se queden atascados.
// ==============================================================================

constant u16 FORMATION_OFFSET_CHAR2 = 28 // Distancia en píxeles del 1er acompañante
constant u16 FORMATION_OFFSET_CHAR3 = 56 // Distancia en píxeles del 2do acompañante

function void Heroes.UpdateFollowerAI(u32 follower_addr, u16 target_offset)
{
    // Determinar la posición del líder activo
    u32 leader_addr = 0xffffb000
    if (heroes.current_leader == HERO_FLY)
        leader_addr = 0xffffb04a
    else if (heroes.current_leader == HERO_POWER)
        leader_addr = heroes.char3_slot

    u16 leader_x = u16[leader_addr + 0x10]
    u16 leader_y = u16[leader_addr + 0x14]
    u8  leader_flags = u8[leader_addr + 0x22]
    bool leader_facing_left = (u8[leader_addr + 0x2a] & 0x01) != 0

    u16 follower_x = u16[follower_addr + 0x10]
    u16 follower_y = u16[follower_addr + 0x14]

    // Calcular posición ideal de la formación detrás del líder
    u16 desired_x = leader_facing_left ? (leader_x + target_offset) : (leader_x - target_offset)

    // Diferencia de distancia
    s16 diff_x = s16(desired_x - follower_x)
    s16 diff_y = s16(leader_y - follower_y)

    // Si el acompañante está demasiado lejos (fuera de pantalla), activar respawn / teleport
    if (diff_x > 360 || diff_x < -360 || diff_y > 260 || diff_y < -260)
    {
        // Reaparecer al lado del líder volando o cayendo suavemente
        u16[follower_addr + 0x10] = leader_x
        u16[follower_addr + 0x14] = leader_y - 32
        s16[follower_addr + 0x18] = 0 // Vel X = 0
        s16[follower_addr + 0x1a] = 0 // Vel Y = 0
        return
    }

    // Seguir hacia la posición objetivo
    if (diff_x > 8)
    {
        // Mover a la derecha
        s16[follower_addr + 0x18] = min(s16[follower_addr + 0x18] + 0x40, 0x600)
        u8[follower_addr + 0x2a] &= ~0x01 // Mirar a la derecha
    }
    else if (diff_x < -8)
    {
        // Mover a la izquierda
        s16[follower_addr + 0x18] = max(s16[follower_addr + 0x18] - 0x40, -0x600)
        u8[follower_addr + 0x2a] |= 0x01 // Mirar a la izquierda
    }
    else
    {
        // Frenar suavemente dentro de la zona de formación
        s16[follower_addr + 0x18] = (s16[follower_addr + 0x18] * 3) / 4
    }

    // Si el líder está en el aire saltando y el acompañante está en el suelo, saltar
    bool leader_in_air = (leader_flags & 0x02) != 0
    bool follower_on_ground = (u8[follower_addr + 0x22] & 0x02) == 0
    if (leader_in_air && follower_on_ground && (diff_y < -16 || abs(diff_x) < 40))
    {
        // Impulso de salto
        s16[follower_addr + 0x1a] = -0x680
        u8[follower_addr + 0x22] |= 0x02 // Marcar estado en el aire
        playSound(0xaf) // Sonido de salto
    }
}
