// ==============================================================================
// ⚡ Sonic Classic Heroes AIR - Habilidades de Equipo y Formaciones Especiales
// ==============================================================================
// Implementa las mecánicas cooperativas de Sonic Heroes:
// 1. Vuelo en Equipo (Team Flight con Tails)
// 2. Formación Rodante (Team Spin Dash con Sonic)
// 3. Rompe-Obstáculos (Power Formation con Knuckles)
// ==============================================================================

// ------------------------------------------------------------------------------
// 1. Vuelo en Equipo (Team Flight)
// ------------------------------------------------------------------------------
function void Heroes.UpdateTeamFlight()
{
    // Solo aplica si el líder activo es el tipo Vuelo (Tails)
    if (heroes.current_leader != HERO_FLY)
        return

    u32 tails_addr = 0xffffb04a
    u8 tails_anim = u8[tails_addr + 0x20]
    
    // Verificar si Tails está en animación de vuelo (anim 0x14 o 0x15 en S3&K)
    bool tails_flying = (tails_anim == 0x14 || tails_anim == 0x15)

    if (tails_flying)
    {
        u16 tails_x = u16[tails_addr + 0x10]
        u16 tails_y = u16[tails_addr + 0x14]

        // Sonic se acopla a la izquierda debajo de Tails
        u32 sonic_addr = 0xffffb000
        u16[sonic_addr + 0x10] = tails_x - 12
        u16[sonic_addr + 0x14] = tails_y + 24
        s16[sonic_addr + 0x18] = s16[tails_addr + 0x18] // Misma velocidad X
        s16[sonic_addr + 0x1a] = s16[tails_addr + 0x1a] // Misma velocidad Y
        u8[sonic_addr + 0x22] |= 0x02 // Mantener en estado de aire

        // Knuckles se acopla a la derecha debajo de Tails
        u32 knuckles_addr = heroes.char3_slot
        u16[knuckles_addr + 0x10] = tails_x + 12
        u16[knuckles_addr + 0x14] = tails_y + 24
        s16[knuckles_addr + 0x18] = s16[tails_addr + 0x18]
        s16[knuckles_addr + 0x1a] = s16[tails_addr + 0x1a]
        u8[knuckles_addr + 0x22] |= 0x02
    }
}

// ------------------------------------------------------------------------------
// 2. Spin Dash en Equipo (Team Spin Dash)
// ------------------------------------------------------------------------------
function void Heroes.UpdateTeamSpinDash()
{
    u32 leader_addr = 0xffffb000
    if (heroes.current_leader == HERO_FLY)
        leader_addr = 0xffffb04a
    else if (heroes.current_leader == HERO_POWER)
        leader_addr = heroes.char3_slot

    u8 leader_status = u8[leader_addr + 0x22]
    u8 leader_anim = u8[leader_addr + 0x20]

    // Si el líder está rodando (rolling o spindash activo)
    bool leader_rolling = (leader_anim == 0x02 || leader_anim == 0x08)

    if (leader_rolling)
    {
        // Poner a los dos acompañantes también a rodar para crear la estela de ataque
        u32 p1 = 0xffffb000
        u32 p2 = 0xffffb04a
        u32 p3 = heroes.char3_slot

        if (leader_addr != p1) u8[p1 + 0x20] = 0x02 // Rolling anim
        if (leader_addr != p2) u8[p2 + 0x20] = 0x02
        if (leader_addr != p3) u8[p3 + 0x20] = 0x02
    }
}

// Hook principal de actualización de equipo por fotograma
function void Heroes.UpdateTeamMechanics()
{
    Heroes.UpdateSwapLogic()
    Heroes.UpdateTeamFlight()
    Heroes.UpdateTeamSpinDash()

    // Actualizar IA de los acompañantes
    if (heroes.current_leader == HERO_SPEED)
    {
        Heroes.UpdateFollowerAI(0xffffb04a, FORMATION_OFFSET_CHAR2)        // Tails sigue a Sonic
        Heroes.UpdateFollowerAI(heroes.char3_slot, FORMATION_OFFSET_CHAR3) // Knuckles sigue a Sonic
    }
    else if (heroes.current_leader == HERO_FLY)
    {
        Heroes.UpdateFollowerAI(0xffffb000, FORMATION_OFFSET_CHAR2)        // Sonic sigue a Tails
        Heroes.UpdateFollowerAI(heroes.char3_slot, FORMATION_OFFSET_CHAR3) // Knuckles sigue a Tails
    }
    else if (heroes.current_leader == HERO_POWER)
    {
        Heroes.UpdateFollowerAI(0xffffb000, FORMATION_OFFSET_CHAR2)        // Sonic sigue a Knuckles
        Heroes.UpdateFollowerAI(0xffffb04a, FORMATION_OFFSET_CHAR3)        // Tails sigue a Knuckles
    }
}
