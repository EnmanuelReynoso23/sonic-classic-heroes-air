// ==============================================================================
// 🐊 Sonic Classic Heroes AIR - Habilidades Exclusivas del Team Chaotix
// ==============================================================================
// 1. Espio (Velocidad):
//    - Trepar paredes verticalmente y salto ninja en diagonal.
// 2. Charmy (Vuelo):
//    - Vuelo continuo sin límite de cansancio (a diferencia de Tails).
// 3. Vector (Fuerza):
//    - Embestida pesada para romper cualquier objeto destructible y trepar rebotando.
// ==============================================================================

function void Chaotix.UpdateEspioAbilities(u32 espio_addr)
{
    // Solo aplicar si el equipo actual es Team Chaotix y Espio está activo
    if (heroes.current_team != TEAM_CHAOTIX)
        return

    // Comprobar colisión frontal con pared
    u8 wall_collision = u8[espio_addr + 0x2e]
    bool jump_pressed = (control.pad1.pressed & CONTROL_A) || (control.pad1.pressed & CONTROL_B) || (control.pad1.pressed & CONTROL_C)

    // Si toca una pared y presiona arriba: comenzar a trepar
    if ((wall_collision & 0x01) && (control.pad1.state & CONTROL_UP))
    {
        s16[espio_addr + 0x1a] = -0x300 // Trepar hacia arriba
        u8[espio_addr + 0x20] = 0x19   // Animación de escalada
    }
}

function void Chaotix.UpdateCharmyFlight(u32 charmy_addr)
{
    if (heroes.current_team != TEAM_CHAOTIX)
        return

    // Charmy no se cansa al volar: resetear el contador de cansancio
    u8[charmy_addr + 0x3c] = 0 // Timer de fatiga de vuelo
}

function void Chaotix.UpdateVectorPower(u32 vector_addr)
{
    if (heroes.current_team != TEAM_CHAOTIX)
        return

    // Embestida en el aire (Air Dash de Vector con doble salto)
    u8 vector_flags = u8[vector_addr + 0x22]
    bool in_air = (vector_flags & 0x02) != 0

    if (in_air && (control.pad1.pressed & CONTROL_A))
    {
        bool facing_left = (u8[vector_addr + 0x2a] & 0x01) != 0
        s16[vector_addr + 0x18] = facing_left ? -0x800 : 0x800
        s16[vector_addr + 0x1a] = 0
        playSound(0xb3) // Sonido de embestida pesada
    }
}
