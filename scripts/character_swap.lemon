// ==============================================================================
// 🔄 Sonic Classic Heroes AIR - Sistema de Intercambio de Líder (Tag System)
// ==============================================================================
// Permite alternar en tiempo real entre:
// [Velocidad -> Vuelo -> Fuerza -> Velocidad] con un solo botón.
// ==============================================================================

function bool Heroes.CheckSwapInput()
{
    // Verificar si se presiona el botón Y (o botón secundario configurado)
    // En Sonic 3 A.I.R., control.pad1.pressed contiene los botones recién pulsados
    // CONTROL_Y = 0x0800 o combinación asignada
    if ((control.pad1.pressed & CONTROL_Y) || (control.pad1.pressed & CONTROL_X))
    {
        return true
    }
    return false
}

function void Heroes.PerformLeaderSwap()
{
    if (heroes.swap_cooldown > 0)
        return

    // Ciclar al siguiente líder: 0 -> 1 -> 2 -> 0
    heroes.prev_leader = heroes.current_leader
    heroes.current_leader = (heroes.current_leader + 1) % 3
    
    // Cooldown para evitar saltos accidentales de líder (12 fotogramas ~ 0.2 seg)
    heroes.swap_cooldown = 12

    // Reproducir efecto sonoro de confirmación (sonido clásico de switch o ring)
    playSound(0x5b)

    // Notificar a la cámara para reenfocar suavemente al nuevo líder
    Heroes.UpdateCameraTarget()
}

function void Heroes.UpdateCameraTarget()
{
    // Dirección del objeto del nuevo líder
    u32 leader_addr = 0xffffb000
    if (heroes.current_leader == HERO_FLY)
    {
        leader_addr = 0xffffb04a // Ranura de Tails
    }
    else if (heroes.current_leader == HERO_POWER)
    {
        leader_addr = heroes.char3_slot // Ranura de Knuckles
    }

    // Centrar la cámara en el líder activo
    camera.target.x = u16[leader_addr + 0x10]
    camera.target.y = u16[leader_addr + 0x14]
}

// Hook en el bucle principal de actualización de controles de personajes
function void Heroes.UpdateSwapLogic()
{
    if (heroes.swap_cooldown > 0)
    {
        heroes.swap_cooldown--
    }

    // No permitir cambio de líder si el líder actual está muerto, ahogándose o en cinemática
    u8 leader_status = u8[0xffffb000 + 0x22]
    if (leader_status & 0x02) // Bit de muerte / respawn
        return

    if (Heroes.CheckSwapInput())
    {
        Heroes.PerformLeaderSwap()
    }
}
