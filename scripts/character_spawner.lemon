// ==============================================================================
// 🐣 Sonic Classic Heroes AIR - Generación y Control del 3er Personaje
// ==============================================================================
// En Sonic 3 & Knuckles estándar solo existen 2 ranuras de jugadores:
// - Jugador 1 (Sonic):   0xffffb000
// - Jugador 2 (Tails):   0xffffb04a
// Este módulo inicializa y mantiene con vida la 3ra ranura:
// - Jugador 3 (Knuckles): 0xffffb094
// ==============================================================================

constant u32 PLAYER3_RAM = 0xffffb094

function void Heroes.SpawnThirdCharacter()
{
    // Si ya está activo o el nivel no ha cargado, salir
    if (u32[PLAYER3_RAM] != 0 && u8[PLAYER3_RAM + 0x38] == 0x03)
        return

    u32 p1 = 0xffffb000
    u16 p1_x = u16[p1 + 0x10]
    u16 p1_y = u16[p1 + 0x14]

    // Inicializar la estructura del Objeto Jugador 3
    // Dirección del código del objeto de personaje (Knuckles)
    u32[PLAYER3_RAM] = 0x016444 // Puntero estándar de objeto jugador en S3&K
    
    // Posición inicial (a la izquierda de Sonic)
    u16[PLAYER3_RAM + 0x10] = p1_x - 32
    u16[PLAYER3_RAM + 0x14] = p1_y
    s16[PLAYER3_RAM + 0x18] = 0
    s16[PLAYER3_RAM + 0x1a] = 0

    // Dimensiones de colisión y radio
    u8[PLAYER3_RAM + 0x16] = 0x13 // Altura estándar
    u8[PLAYER3_RAM + 0x17] = 0x09 // Ancho estándar
    u8[PLAYER3_RAM + 0x18] = 0x13
    u8[PLAYER3_RAM + 0x19] = 0x09

    // Render flags y prioridad de capas
    u8[PLAYER3_RAM + 0x04] = 0x84 // Visible, renderizar sprite
    u8[PLAYER3_RAM + 0x08] = 0x02 // Prioridad 2 en pantalla

    // Identificador de personaje: 3 = Knuckles (o Vector según el equipo)
    u8[PLAYER3_RAM + 0x38] = (heroes.current_team == TEAM_SONIC) ? 0x03 : 0x06

    // Mapeo de paleta de colores (Línea 2 para Knuckles)
    u8[PLAYER3_RAM + 0x0a] = 0x40

    // Guardar referencia en variable global
    heroes.char3_slot = PLAYER3_RAM
}

// Hook al reaparecer o iniciar fase
//# address-hook(0x010a94) end(0x010ba0)
function void Character.Initialize()
{
    base.Character.Initialize()
    Heroes.SpawnThirdCharacter()
}
