// ==============================================================================
// 🎨 Sonic Classic Heroes AIR - HUD de Formación y Líder Activo
// ==============================================================================
// Dibuja en pantalla los 3 iconos del equipo e indica cuál es el líder activo
// (Velocidad: Azul, Vuelo: Amarillo, Fuerza: Rojo)
// ==============================================================================

function void Heroes.RenderTeamHUD()
{
    // Coordenadas base en pantalla (esquina superior izquierda debajo de vidas/anillos)
    u16 base_x = 24
    u16 base_y = 60

    // Si estamos en pausa o pantalla de título, no dibujar
    if (global.game_mode != 0x0c) // 0x0c = modo de juego en nivel normal
        return

    // Dibujar los 3 indicadores de personajes
    // Icono 1: Velocidad (Sonic / Espio)
    bool is_speed_leader = (heroes.current_leader == HERO_SPEED)
    u16 color_speed = is_speed_leader ? 0x0fff : 0x0888

    // Icono 2: Vuelo (Tails / Charmy)
    bool is_fly_leader = (heroes.current_leader == HERO_FLY)
    u16 color_fly = is_fly_leader ? 0x0ff0 : 0x0888

    // Icono 3: Fuerza (Knuckles / Vector)
    bool is_power_leader = (heroes.current_leader == HERO_POWER)
    u16 color_power = is_power_leader ? 0x0f00 : 0x0888

    // En Sonic 3 A.I.R., podemos invocar rutinas de dibujo de texto o sprites
    // Para prototipo visual, agregamos una flecha marcadora sobre el líder
    u16 indicator_offset = (heroes.current_leader == HERO_SPEED) ? 0 : ((heroes.current_leader == HERO_FLY) ? 24 : 48)
    
    // (Opcional) Renderer hook para sprites personalizados de retratos en UI
}

// Hook en la rutina de renderizado del HUD principal
//# address-hook(0x00db44) end(0x00dc00)
function void RenderHUD()
{
    base.RenderHUD()
    Heroes.RenderTeamHUD()
}
